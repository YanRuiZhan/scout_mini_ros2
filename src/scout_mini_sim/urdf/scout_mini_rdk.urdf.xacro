<?xml version="1.0"?>
<!--
  SCOUT MINI R&D KIT, single-file model for Gazebo Sim (Fortress).

  chassis  : Agilex Scout Mini, our calibrated values (cylinder wheel collision,
             23 kg, right wheels at the same height as the left ones)
  upper    : vendor R&D Kit stack, box_Link.STL from AgilexRobotics/ugv_gazebo_sim
             scout/pro/ (SolidWorks export, chassis top deck at z=+0.016 there
             vs z=+0.069 here, hence the +0.053 lift)
  sensors  : RS-Helios 16P, RealSense D435, IMU

  Frame: base_link is 0.181 m above the ground (+x forward, +y left, +z up).
  Everything worth changing is a property at the top of this file.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout_mini_rdk">

  <!-- The two camera sensors dominate render time in headless simulation.
       Set enable_cameras:=false when only lidar/IMU are needed (e.g. FAST-LIO),
       otherwise the lidar and IMU fall well below their configured rates. -->
  <xacro:arg name="enable_cameras" default="true"/>

  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Vendor mesh frame -> ours -->
  <xacro:property name="upper_z_offset" value="0.053"/>
  <!-- SolidWorks mass for the bare stack; raise it to feel the PC and battery -->
  <xacro:property name="upper_mass" value="2.4135"/>
  <!-- Helios: 900 samples = 0.4 deg, 1800 = 0.2 deg. Drop to 450 for speed. -->
  <xacro:property name="lidar_h_samples" value="900"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.0837"/>
  <xacro:property name="wheel_x" value="0.2319755"/>
  <xacro:property name="wheel_y" value="0.245"/>
  <xacro:property name="wheel_z" value="-0.100998"/>
  <xacro:property name="base_height" value="${wheel_radius - wheel_z}"/>

  <!-- Ground projection is the TF root; keep the original chassis coordinates. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================== chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 -${PI/2}"/>
      <geometry>
        <mesh filename="package://scout_mini_sim/meshes/body.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.514618 0.3816 0.10357"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="base_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>

  <link name="inertial_link">
    <inertial>
      <mass value="17"/>
      <!-- datasheet CoM: 160 mm above the ground, i.e. 21 mm below base_link -->
      <origin xyz="0 0 -0.021" rpy="0 0 0"/>
      <inertia ixx="0.221489" ixy="0" ixz="0" iyy="0.390374" iyz="0" izz="0.581471"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <parent link="base_link"/>
    <child link="inertial_link"/>
  </joint>

  <xacro:macro name="wheel" params="name xyz visual_xyz visual_rpy">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="${visual_xyz}" rpy="${visual_rpy}"/>
        <geometry>
          <mesh filename="package://scout_mini_sim/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <!-- cylinder, not the wheel mesh: a mesh wheel on a mesh floor stops
             the robot from moving at all -->
        <origin xyz="0 0 0" rpy="${visual_rpy}"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <inertia ixx="0.003276" ixy="0" ixz="0" iyy="0.004800" iyz="0" izz="0.003276"/>
      </inertial>
    </link>
    <gazebo reference="${name}_wheel_link">
      <visual>
        <visibility_flags>1</visibility_flags>
      </visual>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left" xyz="${wheel_x} ${wheel_y} ${wheel_z}"
    visual_xyz="0 -0.0367485 0" visual_rpy="-${PI/2} 0 0"/>
  <xacro:wheel name="rear_left" xyz="-${wheel_x} ${wheel_y} ${wheel_z}"
    visual_xyz="0 -0.0367485 0" visual_rpy="-${PI/2} 0 0"/>
  <xacro:wheel name="front_right" xyz="${wheel_x} -${wheel_y} ${wheel_z}"
    visual_xyz="0 0.0367485 0" visual_rpy="${PI/2} 0 0"/>
  <xacro:wheel name="rear_right" xyz="-${wheel_x} -${wheel_y} ${wheel_z}"
    visual_xyz="0 0.0367485 0" visual_rpy="${PI/2} 0 0"/>

  <!-- ================================================ R&D Kit stack -->
  <link name="rdk_upper_link">
    <visual>
      <!-- SolidWorks re-export moved the mesh origin to the model corner.
           These offsets restore the old frame: x_min -0.2482, y centred on 0. -->
      <origin xyz="-0.2481905 -0.2772031 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_mini_sim/meshes/upper.dae"/>
      </geometry>
    </visual>
    <!-- Simplified body collision; RTK antenna collision boxes were removed. -->
    <collision>
      <origin xyz="-0.017 0 0.1555" rpy="0 0 0"/>
      <geometry>
        <box size="0.504 0.400 0.279"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.019065 0.0082257 0.11466" rpy="0 0 0"/>
      <mass value="${upper_mass}"/>
      <inertia ixx="0.0088463" ixy="0.000020356" ixz="-0.00047464"
               iyy="0.0066478" iyz="-0.0000069288" izz="0.01219"/>
    </inertial>
  </link>
  <gazebo reference="rdk_upper_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>
  <joint name="rdk_upper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rdk_upper_link"/>
    <origin xyz="0 0 ${upper_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================== sensors
       Poses are measured off the vendor mesh (+/-20 mm), not tape-measured. -->
  <link name="lidar_3d_link"/>
  <joint name="lidar_3d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_3d_link"/>
    <origin xyz="0.05 0 0.30" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_3d_link">
    <sensor name="helios_16p" type="gpu_lidar">
      <!-- one gpu_lidar publishes PointCloud2 to /scout/lidar/points and
           LaserScan to /scout/lidar (remapped to /scan for Nav2) -->
      <topic>/scout/lidar</topic>
      <ignition_frame_id>lidar_3d_link</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <lidar>
        <!-- Exclude robot visuals tagged with visibility bit 0 while retaining
             the world meshes that keep their default all-bits visibility. -->
        <visibility_mask>4294967294</visibility_mask>
        <scan>
          <horizontal>
            <samples>${lidar_h_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2617993877991494</min_angle>
            <max_angle>0.2617993877991494</max_angle>
          </vertical>
        </scan>
        <!-- 80 m covers the ~60 x 30 m warehouse diagonal (~67 m); within this
             closed building a longer range (Helios-16P: 150 m) returns the same
             points. GPU LiDAR may still encode rays with no hit as +/-Inf;
             FAST-LIO preprocessing drops them. -->
        <range>
          <min>0.2</min>
          <max>80.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.2222739 -0.0044991 0.0855002" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
  <xacro:if value="$(arg enable_cameras)">
  <!-- RealSense D435 becomes two sensors: depth and colour have separate
       optical centres (~15 mm apart, see camera_color_joint). A single
       rgbd_camera in Fortress would share one centre and hide that offset.

       HFOV from the datasheet: colour 69.4 deg, depth 85.2 deg. Vertical FOV
       follows from the aspect ratio, which is why the depth image is 16:9 here
       (54.7 deg vertical, the datasheet 58 deg assumes a non-standard crop). -->
  <gazebo reference="camera_color_frame">
    <sensor name="d435_color" type="camera">
      <topic>/camera/color/image</topic>
      <ignition_frame_id>camera_color_optical_frame</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.2113</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="camera_depth_frame">
    <sensor name="d435_depth" type="depth_camera">
      <topic>/camera/depth/image</topic>
      <ignition_frame_id>camera_depth_optical_frame</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.4870</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>true</always_on>
      <!-- FAST-LIO recommends >= 200 Hz IMU; must divide the world's physics rate. -->
      <update_rate>200</update_rate>
    </sensor>
  </gazebo>

  <!-- =================================================== drive -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <!-- skid-steer calibration, NOT the 0.490 geometric track width: a
           four-wheel skid-steer only reaches eta~0.5 of the no-slip yaw rate,
           and Fortress uses this one value for command and odometry alike -->
      <wheel_separation>0.90</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_velocity>3.0</max_linear_velocity>
      <max_angular_velocity>0.40</max_angular_velocity>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
