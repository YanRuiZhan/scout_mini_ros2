<?xml version="1.0"?>
<package format="3">
  <name>scout_mini_navigation</name>
  <version>0.1.0</version>
  <description>Scout Mini simulation navigation with Nav2 and SLAM Toolbox.</description>
  <maintainer email="shlee@roas.co.kr">YanRui</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>scout_mini_sim</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
