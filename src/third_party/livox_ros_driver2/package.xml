<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>1.2.0</version>
  <description>
    Minimal message definitions from livox_ros_driver2.

    FAST-LIO only needs the CustomMsg/CustomPoint types, so this package
    provides them without pulling in Livox-SDK2 and the hardware driver.
  </description>
  <maintainer email="dev@livoxtech.com">Livox</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
